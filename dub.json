{
    "name": "dagm",
    "description": "An implementation of arithmetric-geometric algorithms in D",
    "authors": ["Simon Lederhilger"],
    "targetType": "executable",
    "buildTypes": {
	"release": {
	    "buildOptions": ["releaseMode", "optimize", "inline"]
	}
    },
    "configurations": [
	{
	    "name": "palette",
